{
  "name": "sg-job-hunter",
  "version": "2.0.0",
  "description": "Singapore-first job search for PMETs, run by an AI agent in opencode: find SG/ASEAN jobs, tailor ATS-safe resumes, track applications",
  "main": "lib/index.mjs",
  "type": "module",
  "scripts": {
    "check": "node lib/flow/check.mjs",
    "import-resume": "node lib/flow/import-resume.mjs",
    "find-jobs": "node lib/flow/find-jobs.mjs",
    "save-job": "node lib/flow/save-job.mjs",
    "resume": "node lib/flow/resume.mjs",
    "pipeline": "node lib/flow/pipeline.mjs",
    "status": "node lib/flow/status.mjs",
    "setup": "node setup.mjs",
    "onboard": "node onboard.mjs",
    "doctor": "node doctor.mjs",
    "evaluate": "node lib/evaluate.mjs",
    "scan": "node lib/scan.mjs",
    "scrape": "node lib/scrape-jobs.mjs",
    "scrape-more": "node lib/scrape-more-jobs.mjs",
    "fetch-jds": "node lib/fetch-jds.mjs",
    "convert-cv": "node convert-cv-to-pdf.mjs",
    "convert-cover-letter": "node convert-cover-letter-to-pdf.mjs",
    "merge-tracker": "node lib/merge-tracker.mjs",
    "set-status": "node lib/set-status.mjs",
    "analyze": "node lib/analyze-patterns.mjs",
    "stats": "node lib/stats.mjs",
    "verify": "node lib/verify-pipeline.mjs",
    "check-liveness": "node lib/check-liveness.mjs",
    "reserve-report": "node lib/reserve-report-num.mjs",
    "followup": "node lib/followup-cadence.mjs",
    "coverage": "node lib/coverage-check.mjs",
    "upskill": "node lib/upskill.mjs",
    "salary-gap": "node lib/salary-gap.mjs",
    "salary-benchmarks": "node lib/salary-benchmarks.mjs",
    "test": "node --test tests/flow.test.mjs",
    "prepublishOnly": "node doctor.mjs",
    "test:legacy": "node lib/test-all.mjs"
  },
  "keywords": [
    "job-search",
    "singapore",
    "asean",
    "career",
    "automation",
    "pmet",
    "salary-benchmarks",
    "tech-jobs",
    "finance-jobs",
    "green-economy",
    "care-economy",
    "manufacturing",
    "life-sciences",
    "digital-marketing",
    "consulting",
    "supply-chain",
    "sustainability",
    "esg"
  ],
  "author": "Bertram Yang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamBertBrainCo/sg-job-hunter.git"
  },
  "bugs": {
    "url": "https://github.com/iamBertBrainCo/sg-job-hunter/issues"
  },
  "homepage": "https://github.com/iamBertBrainCo/sg-job-hunter#readme",
  "dependencies": {
    "dotenv": "^18.0.9",
    "js-yaml": "^5.5.0",
    "mammoth": "1.13.0",
    "node-fetch": "^3.3.2",
    "playwright": "^1.40.0",
    "unpdf": "1.8.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
